# API keys for the providers in configs/models.yaml.
# Copy this file to .env (git-ignored) and fill in the keys of the providers
# you use; `socialmaze-hrd evaluate` loads .env from the working directory or
# the repository root. Variables already set in the environment take precedence.

# OpenAI: gpt-4o, gpt-4o-mini, o1, o3-mini
OPENAI_API_KEY=

# DeepSeek: deepseek-v3 (deepseek-chat), deepseek-r1 (deepseek-reasoner)
DEEPSEEK_API_KEY=

# DeepInfra: qwq-32b, qwen-2.5-72b, llama-3.3-70b, llama-3.1-8b, phi-4
DEEPINFRA_API_KEY=

# OpenRouter: any model as openrouter/<vendor>/<model>
OPENROUTER_API_KEY=

# Anthropic (OpenAI-compatible endpoint): claude-sonnet-4.5
ANTHROPIC_API_KEY=

# Google Gemini (OpenAI-compatible endpoint): gemini-2.5-pro
GEMINI_API_KEY=

# Local vLLM / Ollama servers (provider `local`) need no key.
